 "headlines": {
  "旭化成子会社 個人情報55万人余 漏えいの可能性と発表": "Asahikasei की सहायक कंपनी ने बताया कि 5 लाख 50 हज़ार से अधिक व्यक्तियों की निजी जानकारी लीक होने की संभावना है।",
  "ノーベル物理学賞に米大学教授 「IceCube」でニュートリノ観測": "भौतिकी के नोबेल पुरस्कार की ख़बर में अमेरिकी विश्वविद्यालय के प्रोफ़ेसर और “IceCube” से न्यूट्रिनो अवलोकन की बात सुर्खियों में आई है।",
  "企業への不正アクセス被害相次ぐ 個人情報の大規模流出も": "संस्थानों में अनधिकृत प्रवेश से होने वाले नुक़सान की घटनाएँ एक के बाद एक हो रही हैं। निजी जानकारी के बड़े पैमाने पर लीक की घटना का भी सुर्खियों में उल्लेख है।"
 },
 "summaries": {
  "আসাহিকাসেইয়ের অধীনস্থ কোম্পানি জানিয়েছে, ৫ লাখ ৫০ হাজারেরও বেশি ব্যক্তির ব্যক্তিগত তথ্য ফাঁস হওয়ার সম্ভাবনা রয়েছে।": "Asahikasei की सहायक कंपनी ने बताया कि 5 लाख 50 हज़ार से अधिक व्यक्तियों की निजी जानकारी लीक होने की संभावना है।",
  "পদার্থবিদ্যার নোবেল পুরস্কারের খবরে মার্কিন বিশ্ববিদ্যালয়ের অধ্যাপক এবং “IceCube” দিয়ে নিউট্রিনো পর্যবেক্ষণের কথা শিরোনামে এসেছে।": "भौतिकी के नोबेल पुरस्कार की ख़बर में अमेरिकी विश्वविद्यालय के प्रोफ़ेसर और “IceCube” से न्यूट्रिनो अवलोकन की बात सुर्खियों में आई है।",
  "প্রতিষ্ঠানগুলোতে অননুমোদিত প্রবেশের ফলে ক্ষতির ঘটনা একের পর এক ঘটছে। ব্যক্তিগত তথ্যের বড় আকারে ফাঁসের ঘটনাও শিরোনামে উল্লেখ রয়েছে।": "संस्थानों में अनधिकृत प्रवेश से होने वाले नुक़सान की घटनाएँ एक के बाद एक हो रही हैं। निजी जानकारी के बड़े पैमाने पर लीक की घटना का भी सुर्खियों में उल्लेख है।"
 },
 "templates": {
  "এই খবরের বাংলা পাঠ এখনও প্রস্তুত হয়নি। নিচের মূল উৎসের লিংক ব্যবহার করুন।": "इस ख़बर का हिंदी पाठ अभी तैयार नहीं हुआ है। नीचे दिए गए मूल स्रोत के लिंक का उपयोग करें।",
  "জাপানের খবর": "जापान की ख़बरें",
  "এই পাঠে মূল জাপানি শিরোনাম, ফুরিগানা ও নির্বাচিত শব্দের বাংলা অর্থ দেওয়া আছে। বিস্তারিত ও সর্বশেষ খবর নিচের NHK লিংকে পড়ুন।": "इस पाठ में मूल जापानी शीर्षक, फ़ुरिगाना और चुने हुए शब्दों के हिंदी अर्थ दिए गए हैं। विस्तृत और नवीनतम ख़बर नीचे दिए गए NHK लिंक पर पढ़ें।",
  "NHK-এর নতুন সংবাদ। বাংলা পাঠ প্রস্তুত হচ্ছে; মূল উৎসে খবরটি পড়তে পারবেন।": "NHK की नई ख़बर। हिंदी पाठ तैयार हो रहा है; ख़बर मूल स्रोत पर पढ़ सकते हैं।",
  "খবরটির সম্পূর্ণ বাংলা অনুবাদ এখানে দেওয়া হয়নি।": "ख़बर का पूरा हिंदी अनुवाद यहाँ नहीं दिया गया है।",
  "এই খবরের বাংলা ব্যাখ্যা এখনও প্রস্তুত হয়নি। অনুমান করে বিস্তারিত লেখা হয়নি; নিচের মূল উৎসের লিংক ব্যবহার করুন।": "इस ख़बर की हिंदी व्याख्या अभी तैयार नहीं हुई है। अनुमान लगाकर विवरण नहीं लिखा गया है; नीचे दिए गए मूल स्रोत के लिंक का उपयोग करें।",
  "NHK-এর মূল শিরোনাম, উন্মুক্ত IPADIC অভিধানের ফুরিগানা ও যাচাই করা বাংলা শব্দার্থ দিয়ে তৈরি পাঠ। পর্যালোচিত বাংলা সারাংশ পাওয়া গেলে দেখানো হয়। পুরো খবর ও সর্বশেষ তথ্য মূল উৎসে পড়ুন।": "NHK के मूल शीर्षक, खुले IPADIC शब्दकोश के फ़ुरिगाना और सत्यापित हिंदी शब्दार्थों से बना पाठ। समीक्षित हिंदी सारांश उपलब्ध होने पर दिखाया जाता है। पूरी ख़बर और नवीनतम जानकारी मूल स्रोत पर पढ़ें।",
  "নতুন NHK সংবাদ—ফুরিগানা ও বাংলা শব্দার্থসহ শিরোনাম পড়ুন।": "नई NHK ख़बर — फ़ुरिगाना और हिंदी शब्दार्थों के साथ शीर्षक पढ़ें।"
 }
}
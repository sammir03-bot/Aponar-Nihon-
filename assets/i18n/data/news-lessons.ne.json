 "headlines": {
  "旭化成子会社 個人情報55万人余 漏えいの可能性と発表": "असाही कासेईको सहायक कम्पनीले जनाएअनुसार, 550,000 भन्दा बढी व्यक्तिको व्यक्तिगत जानकारी चुहावट हुने सम्भावना छ।",
  "ノーベル物理学賞に米大学教授 「IceCube」でニュートリノ観測": "भौतिकशास्त्रको नोबेल पुरस्कारको समाचारमा अमेरिकी विश्वविद्यालयका प्राध्यापक र 'IceCube' द्वारा न्यूट्रिनो अवलोकनको कुरा शीर्षकमा आएको छ।",
  "企業への不正アクセス被害相次ぐ 個人情報の大規模流出も": "संस्थाहरूमा अनधिकृत प्रवेशका कारण क्षतिका घटनाहरू एकपछि अर्को घटिरहेका छन्। व्यक्तिगत जानकारीको ठूलो चुहावटको घटना पनि शीर्षकमा उल्लेख छ।"
 },
 "summaries": {
  "আসাহিকাসেইয়ের অধীনস্থ কোম্পানি জানিয়েছে, ৫ লাখ ৫০ হাজারেরও বেশি ব্যক্তির ব্যক্তিগত তথ্য ফাঁস হওয়ার সম্ভাবনা রয়েছে।": "असाही कासेईको सहायक कम्पनीले जनाएअनुसार, 550,000 भन्दा बढी व्यक्तिको व्यक्तिगत जानकारी चुहावट हुने सम्भावना छ।",
  "পদার্থবিদ্যার নোবেল পুরস্কারের খবরে মার্কিন বিশ্ববিদ্যালয়ের অধ্যাপক এবং “IceCube” দিয়ে নিউট্রিনো পর্যবেক্ষণের কথা শিরোনামে এসেছে।": "भौतिकशास्त्रको नोबेल पुरस्कारको समाचारमा अमेरिकी विश्वविद्यालयका प्राध्यापक र 'IceCube' द्वारा न्यूट्रिनो अवलोकनको कुरा शीर्षकमा आएको छ।",
  "প্রতিষ্ঠানগুলোতে অননুমোদিত প্রবেশের ফলে ক্ষতির ঘটনা একের পর এক ঘটছে। ব্যক্তিগত তথ্যের বড় আকারে ফাঁসের ঘটনাও শিরোনামে উল্লেখ রয়েছে।": "संस्थाहरूमा अनधिकृत प्रवेशका कारण क्षतिका घटनाहरू एकपछि अर्को घटिरहेका छन्। व्यक्तिगत जानकारीको ठूलो चुहावटको घटना पनि शीर्षकमा उल्लेख छ।"
 },
 "templates": {
  "এই খবরের বাংলা পাঠ এখনও প্রস্তুত হয়নি। নিচের মূল উৎসের লিংক ব্যবহার করুন।": "यस समाचारको नेपाली पाठ अझै तयार भएको छैन। तलको मूल स्रोतको लिङ्क प्रयोग गर्नुहोस्।",
  "জাপানের খবর": "जापानको समाचार",
  "এই পাঠে মূল জাপানি শিরোনাম, ফুরিগানা ও নির্বাচিত শব্দের বাংলা অর্থ দেওয়া আছে। বিস্তারিত ও সর্বশেষ খবর নিচের NHK লিংকে পড়ুন।": "यस पाठमा मूल जापानी शीर्षक, फुरिगाना र छानिएका शब्दहरूको नेपाली अर्थ दिइएको छ। विस्तृत र ताजा समाचार तलको NHK लिङ्कमा पढ्नुहोस्।",
  "NHK-এর নতুন সংবাদ। বাংলা পাঠ প্রস্তুত হচ্ছে; মূল উৎসে খবরটি পড়তে পারবেন।": "NHK को नयाँ समाचार। नेपाली पाठ तयार हुँदै छ; मूल स्रोतमा समाचार पढ्न सक्नुहुन्छ।",
  "খবরটির সম্পূর্ণ বাংলা অনুবাদ এখানে দেওয়া হয়নি।": "यस समाचारको पूर्ण नेपाली अनुवाद यहाँ दिइएको छैन।",
  "এই খবরের বাংলা ব্যাখ্যা এখনও প্রস্তুত হয়নি। অনুমান করে বিস্তারিত লেখা হয়নি; নিচের মূল উৎসের লিংক ব্যবহার করুন।": "यस समाचारको नेपाली व्याख्या अझै तयार भएको छैन। अनुमान गरेर विस्तृत लेखिएको छैन; तलको मूल स्रोतको लिङ्क प्रयोग गर्नुहोस्।",
  "NHK-এর মূল শিরোনাম, উন্মুক্ত IPADIC অভিধানের ফুরিগানা ও যাচাই করা বাংলা শব্দার্থ দিয়ে তৈরি পাঠ। পর্যালোচিত বাংলা সারাংশ পাওয়া গেলে দেখানো হয়। পুরো খবর ও সর্বশেষ তথ্য মূল উৎসে পড়ুন।": "NHK को मूल शीर्षक, खुला IPADIC शब्दकोशको फुरिगाना र प्रमाणित नेपाली शब्दार्थबाट तयार गरिएको पाठ। समीक्षा गरिएको नेपाली सारांश उपलब्ध भएमा देखाइन्छ। पूरा समाचार र ताजा जानकारी मूल स्रोतमा पढ्नुहोस्।",
  "নতুন NHK সংবাদ—ফুরিগানা ও বাংলা শব্দার্থসহ শিরোনাম পড়ুন।": "नयाँ NHK समाचार — फुरिगाना र नेपाली शब्दार्थसहित शीर्षक पढ्नुहोस्।"
 }
}
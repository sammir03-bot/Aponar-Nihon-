 "headlines": {
  "旭化成子会社 個人情報55万人余 漏えいの可能性と発表": "550,000-ത്തിലധികം ആളുകളുടെ വ്യക്തിഗത വിവരങ്ങൾ ചോർന്നിരിക്കാമെന്ന് Asahi Kasei-യുടെ ഒരു അനുബന്ധ സ്ഥാപനം പറഞ്ഞു.",
  "ノーベル物理学賞に米大学教授 「IceCube」でニュートリノ観測": "ഭൗതികശാസ്ത്രത്തിനുള്ള നോബൽ സമ്മാനത്തെക്കുറിച്ചുള്ള വാർത്ത തലക്കെട്ടിൽ ഒരു യുഎസ് സർവകലാശാലയിലെ പ്രൊഫസറെയും 'IceCube' ഉപയോഗിച്ചുള്ള ന്യൂട്രിനോ നിരീക്ഷണത്തെയും പരാമർശിച്ചു.",
  "企業への不正アクセス被害相次ぐ 個人情報の大規模流出も": "സ്ഥാപനങ്ങളിലേക്കുള്ള അനധികൃത പ്രവേശനം മൂലമുള്ള നാശം ഒന്നിനുപുറകെ ഒന്നായി സംഭവിച്ചുകൊണ്ടിരിക്കുന്നു. വ്യക്തിഗത വിവരങ്ങളുടെ വലിയ തോതിലുള്ള ചോർച്ചയും തലക്കെട്ടിൽ പരാമർശിക്കുന്നു."
 },
 "summaries": {
  "আসাহিকাসেইয়ের অধীনস্থ কোম্পানি জানিয়েছে, ৫ লাখ ৫০ হাজারেরও বেশি ব্যক্তির ব্যক্তিগত তথ্য ফাঁস হওয়ার সম্ভাবনা রয়েছে।": "550,000-ത്തിലധികം ആളുകളുടെ വ്യക്തിഗത വിവരങ്ങൾ ചോർന്നിരിക്കാമെന്ന് Asahi Kasei-യുടെ ഒരു അനുബന്ധ സ്ഥാപനം പറഞ്ഞു.",
  "পদার্থবিদ্যার নোবেল পুরস্কারের খবরে মার্কিন বিশ্ববিদ্যালয়ের অধ্যাপক এবং “IceCube” দিয়ে নিউট্রিনো পর্যবেক্ষণের কথা শিরোনামে এসেছে।": "ഭൗതികശാസ്ത്രത്തിനുള്ള നോബൽ സമ്മാനത്തെക്കുറിച്ചുള്ള വാർത്ത തലക്കെട്ടിൽ ഒരു യുഎസ് സർവകലാശാലയിലെ പ്രൊഫസറെയും 'IceCube' ഉപയോഗിച്ചുള്ള ന്യൂട്രിനോ നിരീക്ഷണത്തെയും പരാമർശിച്ചു.",
  "প্রতিষ্ঠানগুলোতে অননুমোদিত প্রবেশের ফলে ক্ষতির ঘটনা একের পর এক ঘটছে। ব্যক্তিগত তথ্যের বড় আকারে ফাঁসের ঘটনাও শিরোনামে উল্লেখ রয়েছে।": "സ്ഥാപനങ്ങളിലേക്കുള്ള അനധികൃത പ്രവേശനം മൂലമുള്ള നാശം ഒന്നിനുപുറകെ ഒന്നായി സംഭവിച്ചുകൊണ്ടിരിക്കുന്നു. വ്യക്തിഗത വിവരങ്ങളുടെ വലിയ തോതിലുള്ള ചോർച്ചയും തലക്കെട്ടിൽ പരാമർശിക്കുന്നു."
 },
 "templates": {
  "এই খবরের বাংলা পাঠ এখনও প্রস্তুত হয়নি। নিচের মূল উৎসের লিংক ব্যবহার করুন।": "ഈ വാർത്തയുടെ മലയാള പതിപ്പ് ഇതുവരെ തയ്യാറായിട്ടില്ല. ദയവായി താഴെയുള്ള യഥാർത്ഥ ഉറവിട ലിങ്ക് ഉപയോഗിക്കുക.",
  "জাপানের খবর": "ജപ്പാൻ വാർത്തകൾ",
  "এই পাঠে মূল জাপানি শিরোনাম, ফুরিগানা ও নির্বাচিত শব্দের বাংলা অর্থ দেওয়া আছে। বিস্তারিত ও সর্বশেষ খবর নিচের NHK লিংকে পড়ুন।": "ഈ പാഠത്തിൽ യഥാർത്ഥ ജാപ്പനീസ് തലക്കെട്ട്, ഫുരിഗാന, തിരഞ്ഞെടുത്ത വാക്കുകളുടെ മലയാളത്തിലുള്ള അർത്ഥങ്ങൾ എന്നിവ ഉൾപ്പെടുന്നു. വിശദമായ, ഏറ്റവും പുതിയ വാർത്തയ്ക്ക്, താഴെയുള്ള NHK ലിങ്ക് വായിക്കുക.",
  "NHK-এর নতুন সংবাদ। বাংলা পাঠ প্রস্তুত হচ্ছে; মূল উৎসে খবরটি পড়তে পারবেন।": "ഒരു പുതിയ NHK വാർത്ത. മലയാള പതിപ്പ് തയ്യാറാക്കിക്കൊണ്ടിരിക്കുന്നു; യഥാർത്ഥ ഉറവിടത്തിൽ നിങ്ങൾക്ക് വാർത്ത വായിക്കാം.",
  "খবরটির সম্পূর্ণ বাংলা অনুবাদ এখানে দেওয়া হয়নি।": "ഈ വാർത്തയുടെ പൂർണ്ണമായ മലയാള വിവർത്തനം ഇവിടെ നൽകിയിട്ടില്ല.",
  "এই খবরের বাংলা ব্যাখ্যা এখনও প্রস্তুত হয়নি। অনুমান করে বিস্তারিত লেখা হয়নি; নিচের মূল উৎসের লিংক ব্যবহার করুন।": "ഈ വാർത്തയ്ക്കുള്ള മലയാള വിശദീകരണം ഇതുവരെ തയ്യാറായിട്ടില്ല. ഊഹത്തെ അടിസ്ഥാനമാക്കി വിശദാംശങ്ങളൊന്നും എഴുതിയിട്ടില്ല; ദയവായി താഴെയുള്ള യഥാർത്ഥ ഉറവിട ലിങ്ക് ഉപയോഗിക്കുക.",
  "NHK-এর মূল শিরোনাম, উন্মুক্ত IPADIC অভিধানের ফুরিগানা ও যাচাই করা বাংলা শব্দার্থ দিয়ে তৈরি পাঠ। পর্যালোচিত বাংলা সারাংশ পাওয়া গেলে দেখানো হয়। পুরো খবর ও সর্বশেষ তথ্য মূল উৎসে পড়ুন।": "NHK-യുടെ യഥാർത്ഥ തലക്കെട്ട്, തുറന്ന IPADIC നിഘണ്ടുവിൽ നിന്നുള്ള ഫുരിഗാന, പരിശോധിച്ച മലയാള വാക്ക് അർത്ഥങ്ങൾ എന്നിവയിൽ നിന്ന് നിർമ്മിച്ച ഒരു പാഠം. ലഭ്യമാകുമ്പോൾ മലയാളത്തിൽ അവലോകനം ചെയ്ത ഒരു സംഗ്രഹം കാണിക്കുന്നു. പൂർണ്ണ വാർത്തയും ഏറ്റവും പുതിയ വിവരങ്ങളും യഥാർത്ഥ ഉറവിടത്തിൽ വായിക്കുക.",
  "নতুন NHK সংবাদ—ফুরিগানা ও বাংলা শব্দার্থসহ শিরোনাম পড়ুন।": "പുതിയ NHK വാർത്ത — ഫുരിഗാനയും മലയാള വാക്ക് അർത്ഥങ്ങളും സഹിതം തലക്കെട്ട് വായിക്കുക."
 }
}
{
  "expo": {
    "name": "Aponar Nihon",
    "slug": "aponar-nihon",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aponarnihon",
    "icon": "../store-assets/app-icon-512.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aponarnihon.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Halal Scanner দিয়ে পণ্যের barcode স্ক্যান করতে camera প্রয়োজন।"
      }
    },
    "android": {
      "package": "com.aponarnihon.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "../store-assets/app-icon-512.png",
        "backgroundColor": "#F7FAFC"
      },
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Halal Scanner দিয়ে পণ্যের barcode স্ক্যান করতে camera ব্যবহার করা হবে।"
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "appOrigin": "https://app.aponar-nihon.workers.dev"
    }
  }
}
